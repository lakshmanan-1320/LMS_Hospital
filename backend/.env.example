# ==========================================
# LMS Backend Configuration Template
# ==========================================

PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Direct pg connection - No ORM)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lms_db
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# JWT & Authentication Security
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters
JWT_ACCESS_EXPIRES_IN=3h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

# Cookie Configuration
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Razorpay Payment Gateway (Test Mode / Sandbox)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_MOCK_MODE=false
RAZORPAY_CURRENCY=INR