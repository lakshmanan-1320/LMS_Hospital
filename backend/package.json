{
  "name": "lms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "LMS Backend built with NestJS, TypeScript, and raw pg (No ORM)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "migrate": "tsx migrations/runner.ts up",
    "migrate:down": "tsx migrations/runner.ts down",
    "migrate:create": "tsx migrations/runner.ts create",
    "seed:admin": "tsx migrations/seed-admin.ts",
    "test:module2": "tsx test/module2-verification.ts",
    "test:enhancements": "tsx test/enhancements-verification.ts",
    "test:closure": "tsx test/student-learning-closure.test.ts",
    "test:certificates": "tsx test/certificates-verification.ts",
    "test:e2e-certs": "tsx test/e2e-course-certificates.ts",
    "test:reconcile": "tsx test/reconcile-verification.ts",
    "test:workflow": "tsx test/verify-student-workflow.ts",
    "test:recovery": "tsx test/error-recovery-verification.ts",
    "test:auth": "tsx test/verify-role-authorizations.ts",
    "test:pdfkit-regen": "tsx test/verify-pdfkit-regeneration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@nestjs/common": "^10.3.3",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.3",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.3.3",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.11.20",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
